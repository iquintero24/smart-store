# PostgreSQL (base de datos del negocio)
POSTGRES_DB=tienda
POSTGRES_USER=tienda
POSTGRES_PASSWORD=cambia_esto

# Base de datos interna de n8n (separada de la del negocio)
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=cambia_esto
N8N_ENCRYPTION_KEY=genera_una_clave_larga_aleatoria

